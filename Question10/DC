module divide_by_n #(
    parameter N = 5
)(
    input clk,
    input reset,
    output reg clk_out
);

localparam WIDTH = (N <= 1) ? 1 : $clog2(N);
reg [WIDTH-1:0] count;

always @(posedge clk or posedge reset) begin
    if (reset) begin
        count <= 0;
        clk_out <= 0;
    end
    else if (count == N-1) begin
        count <= 0;
        clk_out <= ~clk_out;
    end
    else begin
        count <= count + 1'b1;
    end
end

endmodule
