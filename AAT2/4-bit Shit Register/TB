module tb_shift_register;
reg clk, reset, serial_in;
wire serial_out;

shift_register uut (
    .clk(clk),
    .reset(reset),
    .serial_in(serial_in),
    .serial_out(serial_out)
);
always #5 clk = ~clk;
initial begin
    clk = 0;
    reset = 1;
    serial_in = 0;
    #10 reset = 0;
    serial_in = 1; #10;
    serial_in = 0; #10;
    serial_in = 1; #10;
    serial_in = 1; #10;
    serial_in = 0; #10;
    #20 $finish;
end
initial begin
$dumpfile("reg.vcd");
$dumpvars;
end
endmodule
